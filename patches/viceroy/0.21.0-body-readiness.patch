+    #[tokio::test]
+    async fn readiness_repeated_observation_retains_the_original_error() {
+        use futures::FutureExt;
+        use http_body::Body;
+        use std::sync::atomic::Ordering;
+        let identity = std::sync::Arc::new(std::io::Error::other("readiness sentinel"));
+        let (mut body, polls) = readiness_source(
+            vec![
+                Ok(Bytes::new()),
+                Err(std::io::Error::other(identity.clone())),
+            ],
+            false,
+        );
+        body.await_ready().await;
+        let ready_polls = polls.load(Ordering::Relaxed);
+        body.await_ready().await;
