+                .and_then(|error| error.downcast_ref::<std::sync::Arc<std::io::Error>>())
+                .is_some_and(|error| std::sync::Arc::ptr_eq(error, &identity))
+        );
+        assert_eq!(polls.load(Ordering::Relaxed), ready_polls);
+        assert!(body.data().await.is_none());
+    }
