    #[test]
    fn generated_outbound_client_retains_its_clock_in_responses() {
        let scripted = TestOutboundClient::default();
        let start = scripted.time.clock().now();
        let clock = scripted.clock.clone();
        let client = HttpClient::with_client(scripted).with_proxy_marker(false);
        let request = outbound_policy(
            OutboundRequest::get("https://example.com/status/201").expect("request"),
        )
        .response_decoding(ResponseDecoding::Original);
        let response = block_on(client.send(request)).expect("response");
        let deadline = start.checked_add(Duration::from_secs(1)).expect("deadline");
        clock.advance_to(deadline);

        let error = block_on(response.into_bytes_bounded_until(1, Deadline::at_instant(deadline)))
            .expect_err("retained clock reached deadline");

        assert!(matches!(error, EdgeError::GatewayTimeout { .. }));
    }

    fn empty_context(path: &str) -> RequestContext {
        let request = request_builder()
            .method(Method::GET)
            .uri(path)
            .body(Body::empty())
            .expect("request");
        RequestContext::new(request, PathParams::default())
    }

    fn fanout_context(json: &str) -> RequestContext {
        let mut request = request_builder()
            .method(Method::POST)
            .uri("/fanout")
            .body(Body::from(json))
            .expect("request");
        request
            .extensions_mut()
            .insert(HttpClient::with_client(TestOutboundClient::default()));
        RequestContext::new(request, PathParams::default())
    }

    fn context_with_params(path: &str, params: &[(&str, &str)]) -> RequestContext {
        let request = request_builder()
            .method(Method::GET)
            .uri(path)
            .body(Body::empty())
            .expect("request");
        let map = params
            .iter()
            .map(|&(key, value)| (key.to_owned(), value.to_owned()))
            .collect::<HashMap<_, _>>();
        RequestContext::new(request, PathParams::new(map))
    }

    fn context_with_header(path: &str, header: HeaderName, value: HeaderValue) -> RequestContext {
        let mut request = request_builder()
            .method(Method::GET)
            .uri(path)
            .body(Body::empty())
            .expect("request");
        request.headers_mut().insert(header, value);
        RequestContext::new(request, PathParams::default())
    }

    fn context_with_json(path: &str, json: &str) -> RequestContext {
        let request = request_builder()
            .method(Method::POST)
            .uri(path)
            .body(Body::from(json))
            .expect("request");
        RequestContext::new(request, PathParams::default())
    }
